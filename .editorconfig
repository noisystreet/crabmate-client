root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,html}]
indent_style = space
indent_size = 2

# 手改 Android Kotlin；gen/android/.editorconfig（indent 2）对壳工程优先
[*.{kt,kts}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
