<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 原生层设计令牌：与 Web 端 frontend/styles/tokens.css 的 :root 逐项一一对应，
         命名映射为 cm_<token>（下划线代替连字符），色值刻意重复书写一份。
         两侧一致性由 scripts/check-token-mirrors.sh 机械校验；改一处必须同时改另一处。
         本文件只放这类镜像令牌，不放裸颜色。 -->
    <color name="cm_bg">#FF07090E</color>
    <color name="cm_surface">#FF161727</color>
    <color name="cm_text">#FFEEF1F6</color>
    <color name="cm_muted">#FF9099B4</color>
    <color name="cm_accent">#FF8FA4EA</color>
    <color name="cm_error">#FFC98C9B</color>
</resources>
