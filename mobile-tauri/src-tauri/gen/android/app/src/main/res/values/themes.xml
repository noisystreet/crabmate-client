<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.crabmate_mobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 与 Web 端 CSS 变量 bg（#07090E）对齐，冷启动 / 导航间隙不闪系统白或黑默认底。注意：XML 注释不允许出现连续两个减号，故不写变量名前的连字符 -->
        <item name="android:windowBackground">#07090E</item>
        <item name="android:colorBackground">#07090E</item>
        <item name="android:statusBarColor">#07090E</item>
        <item name="android:navigationBarColor">#07090E</item>
    </style>
</resources>
